{
  "schemaVersion": 1,
  "id": "french-kitchen",
  "version": "${version}",
  "name": "French Kitchen",
  "description": "Food, preparation and realistic cooking for Minecraft.",
  "authors": [
    "Mathys Lefebvre"
  ],
  "license": "CC0-1.0",
  "icon": "assets/french-kitchen/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "fr.mathyslefebvre.frenchkitchen.FrenchKitchen"
    ],
    "client": [
      "fr.mathyslefebvre.frenchkitchen.client.FrenchKitchenClient"
    ]
  },
  "mixins": [
